{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408-viz.local/schemas/fsm.schema.json",
  "title": "408-Viz FSM IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_type", "meta", "states", "transitions", "presets"],
  "properties": {
    "schema_version": { "const": 1 },
    "struct_type": { "const": "fsm" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/state" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/transition" }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "col"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "type": { "enum": ["start", "active", "success", "failure", "terminal"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "sublabel": { "type": "string", "maxLength": 40 },
        "col": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": { "$ref": "#/$defs/fsmStep" }
        }
      }
    },
    "fsmStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "title", "desc"],
      "properties": {
        "active": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string" }
        },
        "lastTrans": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "desc": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
