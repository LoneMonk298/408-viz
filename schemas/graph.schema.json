{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408-viz.local/schemas/graph.schema.json",
  "title": "408-Viz Graph IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_type", "meta", "nodes", "edges", "presets"],
  "properties": {
    "schema_version": { "const": 1 },
    "struct_type": { "const": "graph" },
    "directed": { "type": "boolean" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/edge" }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "label": { "type": "string", "maxLength": 8 },
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 999 }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "desc"],
      "properties": {
        "hl": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/nodeHighlight" }
        },
        "edge_hl": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/edgeHighlight" }
        },
        "vals": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/nodeVal" }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "desc": { "type": "string", "maxLength": 400 }
      }
    },
    "nodeHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind"],
      "properties": {
        "node_id": { "type": "string" },
        "kind": { "enum": ["visit", "frontier", "done", "path", "found"] }
      }
    },
    "edgeHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "kind"],
      "properties": {
        "edge_id": { "type": "string" },
        "kind": { "enum": ["relax", "tree", "path"] }
      }
    },
    "nodeVal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "val"],
      "properties": {
        "node_id": { "type": "string" },
        "val": { "type": ["string", "integer"], "maxLength": 8 }
      }
    }
  }
}
