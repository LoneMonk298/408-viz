{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408-viz.local/schemas/mindmap.schema.json",
  "title": "408-Viz Mindmap IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_type", "meta", "presets"],
  "properties": {
    "schema_version": { "const": 1 },
    "struct_type": { "const": "mindmap" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "root": { "$ref": "#/$defs/node" },
        "hl": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/nodeHighlight" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "desc": { "type": "string", "maxLength": 100 },
        "children": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/node" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "nodeHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind"],
      "properties": {
        "node_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
        "kind": { "enum": ["concept", "contrast"] }
      }
    }
  }
}
