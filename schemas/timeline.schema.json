{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408-viz.local/schemas/timeline.schema.json",
  "title": "408-Viz Timeline IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_type", "meta", "rows", "presets"],
  "properties": {
    "schema_version": { "const": 1 },
    "struct_type": { "const": "timeline" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/row" }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 16 }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bars", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/bar" }
        },
        "markers": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/marker" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "row", "start", "end"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "row": { "type": "string" },
        "label": { "type": "string", "maxLength": 12 },
        "start": { "type": "number", "minimum": 0, "maximum": 1000 },
        "end": { "type": "number", "minimum": 0, "maximum": 1000 },
        "kind": { "enum": ["run", "io", "idle"] }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t"],
      "properties": {
        "t": { "type": "number", "minimum": 0, "maximum": 1000 },
        "label": { "type": "string", "maxLength": 16 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reveal", "title", "desc"],
      "properties": {
        "reveal": { "type": "number", "minimum": 0, "maximum": 1000 },
        "active": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "desc": { "type": "string", "maxLength": 400 }
      }
    }
  }
}
