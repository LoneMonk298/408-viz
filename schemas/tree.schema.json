{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408-viz.local/schemas/tree.schema.json",
  "title": "408-Viz Tree IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "struct_type", "meta", "presets"],
  "properties": {
    "schema_version": { "const": 1 },
    "struct_type": { "const": "tree" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "title", "desc"],
      "properties": {
        "tree": { "$ref": "#/$defs/node" },
        "hl": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/highlight" }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "desc": { "type": "string", "maxLength": 400 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "val"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]{1,24}$" },
        "val": { "type": ["integer", "string"] },
        "children": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind"],
      "properties": {
        "node_id": { "type": "string" },
        "kind": {
          "enum": ["insert", "visit", "unbalanced", "rotated", "compare", "removed"]
        }
      }
    }
  }
}
